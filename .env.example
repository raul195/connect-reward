# Supabase — get from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend email — get API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxx
EMAIL_FROM=Connect Reward <noreply@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com

# Resend webhook secret — get from Resend Dashboard → Webhooks → Signing secret
RESEND_WEBHOOK_SECRET=whsec_xxx

# App URL (your production domain)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Cron secret for Vercel Cron jobs — generate a random string
CRON_SECRET=your-random-cron-secret

# Google Analytics 4 — get from GA4 Admin → Data Streams → Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console — get from Search Console → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Stripe — get keys from Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Stripe webhook secret — get from Stripe Dashboard → Developers → Webhooks → Select endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx
